    function validCardTombstoneCreate(workspaceId, boardId, cardId) {
      let data = request.resource.data;
      let card = cardPath(workspaceId, boardId, cardId);
      return data.keys().hasAll(['schemaVersion', 'entityType', 'boardId', 'entityId', 'listId', 'operationId', 'deletedByUid', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'entityType', 'boardId', 'entityId', 'listId', 'operationId', 'deletedByUid', 'createdAt'])
        && data.schemaVersion == 1
        && data.entityType == 'card'
        && data.boardId == boardId
        && data.entityId == cardId
        && data.listId is string
        && data.deletedByUid == request.auth.uid
        && data.createdAt == request.time
        && exists(card)
        && data.listId == get(card).data.listId
        && getAfter(card).data.lifecycleState == 'deleting'
        && getAfter(card).data.activeDeletionJobId == data.operationId
        && usableDeletionJobAfter(workspaceId, data.operationId, boardId, 'card', cardId, data.listId);
    }
    function validBoardPurgeDelete(workspaceId, boardId) {
      let control = boardLifecyclePath(workspaceId, boardId);
      return exists(control)
        && get(control).data.targetType == 'board'
        && usableDeletionJob(workspaceId, get(control).data.operationId, boardId, 'board', boardId, '');
    }
    function validListPurgeDelete(workspaceId, boardId, listId) {
      let tombstone = deletedListPath(workspaceId, boardId, listId);
      return exists(tombstone)
        && get(tombstone).data.entityId == listId
        && usableDeletionJob(workspaceId, get(tombstone).data.operationId, boardId, 'list', listId, '');
    }
    function validCardPurgeDelete(workspaceId, boardId, cardId) {
      let tombstone = deletedCardPath(workspaceId, boardId, cardId);
      return exists(tombstone)
        && get(tombstone).data.entityId == cardId
        && usableDeletionJob(workspaceId, get(tombstone).data.operationId, boardId, 'card', cardId, get(tombstone).data.listId);
    }
    function validCommentPurgeDelete(workspaceId, boardId, cardId) {
      let tombstone = deletedCardPath(workspaceId, boardId, cardId);
      return exists(tombstone)
        && usableDeletionJob(workspaceId, get(tombstone).data.operationId, boardId, 'card', cardId, get(tombstone).data.listId);
    }
    function validDeletionJobComplete(workspaceId, operationId) {
      let data = request.resource.data;
      let control = getAfter(boardLifecyclePath(workspaceId, resource.data.boardId)).data;
      let board = boardPath(workspaceId, resource.data.boardId);
      return resource.data.state == 'deleting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt', 'revision'])
        && data.state == 'complete'
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && deletionRoleAllowed(workspaceId, data.targetType)
        && control.operationId == operationId
        && (
          (data.targetType == 'board' && control.state == 'deleted' && !existsAfter(board))
          || (data.targetType in ['list', 'card']
            && control.state == 'active'
            && getAfter(board).data.get('lifecycleState', 'active') == 'active'
            && getAfter(board).data.activeDeletionJobId == null)
        );
    }
    function validLifecycleFinish(workspaceId, boardId) {
      let data = request.resource.data;
      let job = getAfter(deletionJobPath(workspaceId, resource.data.operationId)).data;
      let board = boardPath(workspaceId, boardId);
      return resource.data.state == 'deleting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'completedAt', 'revision'])
        && data.completedAt == request.time
        && data.revision == resource.data.revision + 1
        && job.operationId == resource.data.operationId
        && job.state == 'complete'
        && deletionRoleAllowed(workspaceId, job.targetType)
        && (
          (job.targetType == 'board' && data.state == 'deleted' && !existsAfter(board))
          || (job.targetType in ['list', 'card']
            && data.state == 'active'
            && getAfter(board).data.get('lifecycleState', 'active') == 'active'
            && getAfter(board).data.activeDeletionJobId == null)
        );
