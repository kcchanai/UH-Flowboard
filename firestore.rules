    function validBoardDeletionUnlock(workspaceId, boardId) {
      let operationId = resource.data.activeDeletionJobId;
      let job = getAfter(deletionJobPath(workspaceId, operationId)).data;
      let control = getAfter(boardLifecyclePath(workspaceId, boardId)).data;
      return resource.data.get('lifecycleState', 'active') == 'deleting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifecycleState', 'activeDeletionJobId', 'revision', 'clientMutationId', 'updatedAt'])
        && request.resource.data.lifecycleState == 'active'
        && request.resource.data.activeDeletionJobId == null
        && validRevision()
        && request.resource.data.clientMutationId == operationId
        && job.operationId == operationId
        && job.state == 'complete'
        && job.targetType in ['list', 'card']
        && deletionRoleAllowed(workspaceId, job.targetType)
        && control.operationId == operationId
        && control.state == 'active';
    }

    function validUserProfileShape(uid, data) {
      return data.keys().hasAll(['uid', 'emailLower', 'workspaceIds'])
        && data.keys().hasOnly(['uid', 'emailLower', 'workspaceIds', 'personalWorkspaceId'])
        && data.uid == uid
        && data.emailLower == request.auth.token.email.lower()
        && data.workspaceIds is list
        && data.workspaceIds.size() <= 100;
    }
    function validPersonalWorkspacePointer(uid, data) {
      return !data.keys().hasAny(['personalWorkspaceId'])
        || data.personalWorkspaceId == null
        || data.personalWorkspaceId == ''
        || (data.personalWorkspaceId is string
          && data.personalWorkspaceId.size() <= 500
          && getAfter(workspaceDoc(data.personalWorkspaceId)).data.personal == true
          && getAfter(workspaceDoc(data.personalWorkspaceId)).data.status == 'ready'
          && getAfter(workspaceDoc(data.personalWorkspaceId)).data.migration.state == 'verified'
          && getAfter(workspaceDoc(data.personalWorkspaceId)).data.ownerUid == uid
          && getAfter(memberDoc(data.personalWorkspaceId, uid)).data.uid == uid
          && getAfter(memberDoc(data.personalWorkspaceId, uid)).data.role == 'owner');
    }
    function establishedPersonalPointer(uid) {
      return resource.data.keys().hasAny(['personalWorkspaceId'])
        && resource.data.personalWorkspaceId is string
        && resource.data.personalWorkspaceId.size() > 0;
    }
    function validPersonalWorkspaceUpdate(uid) {
      return !establishedPersonalPointer(uid)
        ? validPersonalWorkspacePointer(uid, request.resource.data)
        : request.resource.data.keys().hasAny(['personalWorkspaceId'])
          && request.resource.data.personalWorkspaceId == resource.data.personalWorkspaceId;
    }
    function validUserProfileCreate(uid) {
      return verifiedEmail()
        && request.auth.uid == uid
        && validUserProfileShape(uid, request.resource.data)
        && validPersonalWorkspacePointer(uid, request.resource.data);
    }
    function validUserProfileUpdate(uid) {
      return verifiedEmail()
        && request.auth.uid == uid
        && validUserProfileShape(uid, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.emailLower == resource.data.emailLower
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workspaceIds', 'personalWorkspaceId'])
        && validPersonalWorkspaceUpdate(uid);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if validUserProfileCreate(uid);
      allow update: if validUserProfileUpdate(uid);
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(memberDoc(workspaceId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(memberDoc(workspaceId, request.auth.uid)).data.role == 'owner';
      allow update: if validWorkspaceOwnerUpdate(workspaceId) || validOwnershipTransfer(workspaceId);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(workspaceId);
        allow create: if signedIn()
          && request.resource.data.uid == uid
          && validRole(request.resource.data.role)
          && validMemberProfile(request.resource.data)
          && (
            (uid == request.auth.uid
              && request.resource.data.role == 'owner'
              && getAfter(workspaceDoc(workspaceId)).data.ownerUid == uid)
            || (isActiveWorkspace(workspaceId) && (
              (isOwner(workspaceId) && request.resource.data.role in ['editor', 'viewer'])
              || (uid == request.auth.uid && validInviteMembershipCreate(workspaceId, uid))
            ))
          );
        allow update: if validOwnMemberProfileUpdate(workspaceId, uid) || isActiveWorkspace(workspaceId) && (
          validTransferredMemberUpdate(workspaceId, uid) || (
            isOwner(workspaceId)
            && resource.data.role in ['editor', 'viewer']
            && request.resource.data.uid == uid
            && request.resource.data.emailLower == resource.data.emailLower
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['editor', 'viewer']
          )
        );
        allow delete: if isActiveWorkspace(workspaceId) && (
          validSelfLeave(workspaceId, uid)
          || (isOwner(workspaceId) && resource.data.role != 'owner')
        );
      }

      match /invites/{inviteId} {
        allow read: if isOwner(workspaceId) || activeInviteForCurrentUser(resource.data);
        allow create: if isActiveWorkspace(workspaceId) && isOwner(workspaceId) && validInviteShape(request.resource.data);
        allow update: if isActiveWorkspace(workspaceId) && (
          (isOwner(workspaceId)
            && resource.data.revokedAt == null
            && resource.data.acceptedAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt'])
            && request.resource.data.revokedAt == request.time)
          || validInviteAcceptance(workspaceId, inviteId)
        );
        allow delete: if false;
      }

      match /imports/{operationId} {
        allow get: if isOwner(workspaceId);
        allow list: if false;
        allow create: if validImportCreate(workspaceId, operationId);
        allow update: if validImportComplete(workspaceId, operationId);
        allow delete: if false;
      }

      match /deletionJobs/{operationId} {
        allow read: if isMember(workspaceId);
        allow create: if validDeletionJobCreate(workspaceId, operationId);
        allow update: if validDeletionJobComplete(workspaceId, operationId);
        allow delete: if false;
      }

      match /boardLifecycle/{boardId} {
        allow read: if isMember(workspaceId);
        allow create: if validLifecycleStart(workspaceId, boardId, true);
        allow update: if validLifecycleStart(workspaceId, boardId, false) || validLifecycleFinish(workspaceId, boardId);
        allow delete: if false;
        match /deletedLists/{listId} {
          allow read: if isMember(workspaceId);
          allow create: if validListTombstoneCreate(workspaceId, boardId, listId);
          allow update, delete: if false;
        }
        match /deletedCards/{cardId} {
          allow read: if isMember(workspaceId);
          allow create: if validCardTombstoneCreate(workspaceId, boardId, cardId);
          allow update, delete: if false;
        }
      }

      match /boards/{boardId} {
        allow get: if boardReadable(workspaceId, boardId) || archivedBoardOwnerReadable(workspaceId, boardId) || boardPurgeReadable(workspaceId, boardId) || entityPurgeBoardReadable(workspaceId, boardId)
          || (resource.data.get('lifecycleState', '') == 'importing' && isOwner(workspaceId)
            && validOperationId(resource.data.importOperationId))
          || (canEdit(workspaceId) && !exists(boardPath(workspaceId, boardId))
            && !exists(boardLifecyclePath(workspaceId, boardId)));
        allow list: if canReadWorkspaceContent(workspaceId)
          && resource.data.lifecycleState == 'active'
          && resource.data.archived == false;
        allow list: if isOwner(workspaceId) && canReadWorkspaceContent(workspaceId)
          && resource.data.lifecycleState == 'active';

        allow create: if (canEdit(workspaceId)
          && validInitialRevision()
          && request.resource.data.get('archived', false) == false
          && request.resource.data.get('lifecycleState', 'active') == 'active'
          && !request.resource.data.keys().hasAny(['activeDeletionJobId', 'importOperationId', 'migrationOperationId', 'lastMigrationOperationId', 'snapshot', 'granularVersion'])
          && !existsAfter(boardLifecyclePath(workspaceId, boardId)))
          || (request.resource.data.get('lifecycleState', '') == 'importing' && validImportedBoardCreate(workspaceId, boardId));
        allow update: if (
          boardWritable(workspaceId, boardId)
            && validRevision()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifecycleState', 'activeDeletionJobId', 'snapshot', 'granularVersion', 'archived', 'archivedAt', 'archivedByUid', 'importOperationId', 'migrationOperationId', 'lastMigrationOperationId'])
        ) || validBoardArchiveUpdate(workspaceId, boardId) || validBoardDeletionLock(workspaceId, boardId) || validBoardDeletionUnlock(workspaceId, boardId)
          || (resource.data.get('lifecycleState', '') == 'importing'
            && (validImportedBoardUpdate(workspaceId, boardId) || validImportedBoardFinalize(workspaceId, boardId)))
          || (request.resource.data.keys().hasAny(['lastMigrationOperationId']) && validSnapshotScrub(workspaceId, boardId));
        allow delete: if validBoardPurgeDelete(workspaceId, boardId);
        match /lists/{listId} {
          allow get: if (boardReadable(workspaceId, boardId)
            && resource.data.get('lifecycleState', 'active') == 'active'
            && !exists(deletedListPath(workspaceId, boardId, listId)))
            || listPurgeReadable(workspaceId, boardId, listId)
            || (archivedBoardOwnerReadable(workspaceId, boardId) && resource.data.get('lifecycleState', 'active') == 'active')
            || (resource.data.keys().hasAny(['importOperationId']) && isOwner(workspaceId)
              && get(boardPath(workspaceId, boardId)).data.lifecycleState == 'importing'
              && resource.data.importOperationId == get(boardPath(workspaceId, boardId)).data.importOperationId)
            || (boardWritable(workspaceId, boardId) && !exists(listPath(workspaceId, boardId, listId))
              && listIsLiveAfter(workspaceId, boardId, listId));
          allow list: if (boardReadable(workspaceId, boardId) || archivedBoardOwnerReadable(workspaceId, boardId))
            && resource.data.lifecycleState == 'active';
          allow list: if listPurgeReadable(workspaceId, boardId, listId);
          allow create: if (boardWritable(workspaceId, boardId)
            && request.resource.data.get('lifecycleState', 'active') == 'active'
            && !request.resource.data.keys().hasAny(['activeDeletionJobId', 'importOperationId', 'migrationOperationId', 'lastMigrationOperationId'])
            && listIsLiveAfter(workspaceId, boardId, listId)
            && validInitialRevision())
            || (request.resource.data.keys().hasAny(['importOperationId']) && validImportedListWrite(workspaceId, boardId, listId, true))
            || (request.resource.data.keys().hasAny(['migrationOperationId']) && validMigrationListWrite(workspaceId, boardId, listId, true));
          allow update: if (
            boardWritable(workspaceId, boardId)
              && request.resource.data.get('lifecycleState', 'active') == 'active'
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifecycleState', 'activeDeletionJobId', 'importOperationId', 'migrationOperationId'])
              && listIsLiveAfter(workspaceId, boardId, listId)
              && validRevision()
          ) || validListDeletionLock(workspaceId, boardId, listId)
            || (request.resource.data.keys().hasAny(['importOperationId']) && validImportedListWrite(workspaceId, boardId, listId, false))
            || (request.resource.data.keys().hasAny(['migrationOperationId']) && validMigrationListWrite(workspaceId, boardId, listId, false));
          allow delete: if validListPurgeDelete(workspaceId, boardId, listId);
        }
        match /cards/{cardId} {
          allow get: if (
            boardReadable(workspaceId, boardId)
              && resource.data.get('lifecycleState', 'active') == 'active'
              && activeList(workspaceId, boardId, resource.data.listId)
              && !exists(deletedCardPath(workspaceId, boardId, cardId))
          ) || cardPurgeReadable(workspaceId, boardId, cardId, resource.data.listId)
            || (!exists(cardPath(workspaceId, boardId, cardId)) && missingCardPurgeReadable(workspaceId, boardId, cardId))
            || (archivedBoardOwnerReadable(workspaceId, boardId)
              && resource.data.get('lifecycleState', 'active') == 'active'
              && activeList(workspaceId, boardId, resource.data.listId))
            || (resource.data.keys().hasAny(['importOperationId']) && isOwner(workspaceId)
              && get(boardPath(workspaceId, boardId)).data.lifecycleState == 'importing'
              && resource.data.importOperationId == get(boardPath(workspaceId, boardId)).data.importOperationId)
            || (boardWritable(workspaceId, boardId) && !exists(cardPath(workspaceId, boardId, cardId))
              && !exists(deletedCardPath(workspaceId, boardId, cardId)));
          allow list: if (
            boardReadable(workspaceId, boardId)
              && resource.data.lifecycleState == 'active'
              && activeList(workspaceId, boardId, resource.data.listId)
          ) || cardPurgeReadable(workspaceId, boardId, cardId, resource.data.listId)
            || (!exists(cardPath(workspaceId, boardId, cardId)) && missingCardPurgeReadable(workspaceId, boardId, cardId))
            || (archivedBoardOwnerReadable(workspaceId, boardId)
              && resource.data.lifecycleState == 'active'
              && activeList(workspaceId, boardId, resource.data.listId));
          allow create: if (boardWritable(workspaceId, boardId)
            && existsAfter(listPath(workspaceId, boardId, request.resource.data.listId))
            && request.resource.data.get('lifecycleState', 'active') == 'active'
            && !request.resource.data.keys().hasAny(['activeDeletionJobId', 'importOperationId', 'migrationOperationId', 'lastMigrationOperationId'])
            && listIsLiveAfter(workspaceId, boardId, request.resource.data.listId)
            && cardIsLiveAfter(workspaceId, boardId, cardId, request.resource.data.listId)
            && validInitialRevision()
            && validCardAssignments(workspaceId, request.resource.data))
            || (request.resource.data.keys().hasAny(['importOperationId']) && validImportedCardWrite(workspaceId, boardId, cardId, true))
            || (request.resource.data.keys().hasAny(['migrationOperationId']) && validMigrationCardWrite(workspaceId, boardId, cardId, true));
          allow update: if (
            boardWritable(workspaceId, boardId)
              && existsAfter(listPath(workspaceId, boardId, request.resource.data.listId))
              && request.resource.data.get('lifecycleState', 'active') == 'active'
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifecycleState', 'activeDeletionJobId', 'importOperationId', 'migrationOperationId'])
              && listIsLiveAfter(workspaceId, boardId, request.resource.data.listId)
              && cardIsLiveAfter(workspaceId, boardId, cardId, request.resource.data.listId)
              && validRevision()
              && validCardAssignmentUpdate(workspaceId)
          ) || validCardDeletionLock(workspaceId, boardId, cardId)
            || (request.resource.data.keys().hasAny(['importOperationId']) && validImportedCardWrite(workspaceId, boardId, cardId, false))
            || (request.resource.data.keys().hasAny(['migrationOperationId']) && validMigrationCardWrite(workspaceId, boardId, cardId, false));
          allow delete: if validCardPurgeDelete(workspaceId, boardId, cardId);
          match /comments/{commentId} {
            allow get: if isMember(workspaceId) && (commentParentsExist(workspaceId, boardId, cardId) || archivedCommentParentsExist(workspaceId, boardId, cardId) || commentPurgeReadable(workspaceId, boardId, cardId));
            allow list: if isMember(workspaceId)
              && (commentParentsExist(workspaceId, boardId, cardId) || archivedCommentParentsExist(workspaceId, boardId, cardId) || commentPurgeReadable(workspaceId, boardId, cardId))
              && request.query.limit != null && request.query.limit <= 25;
            allow create: if commentParentsWritableAfter(workspaceId, boardId, cardId)
              && validCommentCreate(workspaceId, boardId, commentId);
            allow update: if commentParentsWritableAfter(workspaceId, boardId, cardId)
              && (validCommentEdit(workspaceId, boardId) || validCommentRemoval(workspaceId, boardId));
            allow delete: if validCommentPurgeDelete(workspaceId, boardId, cardId);
          }
        }
      }

      match /activity/{activityId} {
        allow read: if isMember(workspaceId) && isActiveWorkspace(workspaceId);
        allow create: if canEdit(workspaceId) && validActivity(request.resource.data, activityId);
        allow update, delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
