        && resource.data.deletedAt == null
        && data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt', 'revision', 'clientMutationId'])
        && validCommentBody(data.body)
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && data.clientMutationId is string
        && data.clientMutationId.size() >= 16
        && data.clientMutationId.size() <= 128
        && validCommentActivity(workspaceId, boardId, data.clientMutationId, 'comment-updated');
    }
    function validCommentRemoval(workspaceId, boardId) {
      let data = request.resource.data;
      return (resource.data.authorUid == request.auth.uid || isOwner(workspaceId))
        && resource.data.deletedAt == null
        && data.diff(resource.data).affectedKeys().hasOnly(['body', 'deletedAt', 'updatedAt', 'revision', 'clientMutationId'])
        && data.body == ''
        && data.deletedAt == request.time
        && data.updatedAt == request.time
        && data.revision == resource.data.revision + 1
        && data.clientMutationId is string
        && data.clientMutationId.size() >= 16
        && data.clientMutationId.size() <= 128
        && validCommentActivity(workspaceId, boardId, data.clientMutationId, 'comment-deleted');
    }

    function validActivity(data, activityId) {
      return data.keys().hasAll(['actorUid', 'action', 'boardId', 'clientMutationId', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'action', 'boardId', 'clientMutationId', 'createdAt'])
        && data.actorUid == request.auth.uid
        && data.action in ['board-created', 'board-updated', 'card-created', 'card-updated', 'card-moved', 'card-assigned', 'comment-created', 'comment-updated', 'comment-deleted', 'list-created', 'list-updated', 'workspace-updated']
        && data.boardId is string
        && data.boardId.size() <= 128
        && data.clientMutationId is string
        && data.clientMutationId == activityId
        && data.clientMutationId.size() >= 16
        && data.clientMutationId.size() <= 128
        && data.createdAt == request.time;
    }

    function validDeletionJobShape(data, operationId) {
      return data.keys().hasAll(['schemaVersion', 'operationId', 'boardId', 'targetType', 'targetId', 'initiatorUid', 'state', 'expectedRevision', 'createdAt', 'updatedAt', 'revision'])
        && data.keys().hasOnly(['schemaVersion', 'operationId', 'boardId', 'targetType', 'targetId', 'initiatorUid', 'state', 'expectedRevision', 'createdAt', 'updatedAt', 'revision'])
        && data.schemaVersion == 1
        && data.operationId == operationId
        && validOperationId(data.operationId)
        && data.boardId is string
        && data.boardId.size() > 0
        && data.boardId.size() <= 500
        && data.targetType in ['board', 'list', 'card']
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetId.size() <= 500
        && data.initiatorUid == request.auth.uid
        && data.state == 'deleting'
        && data.expectedRevision is int
        && data.expectedRevision >= 0
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.revision == 0;
    }
    function validDeletionTarget(workspaceId, data) {
      let board = boardPath(workspaceId, data.boardId);
      return exists(board)
        && get(board).data.get('revision', 0) == data.expectedRevision
        && (data.targetType == 'board' || !get(board).data.keys().hasAny(['snapshot']))
        && deletionRoleAllowed(workspaceId, data.targetType)
        && (
          (data.targetType == 'board' && data.targetId == data.boardId)
          || (data.targetType == 'list'
            && get(board).data.get('archived', false) == false
            && exists(listPath(workspaceId, data.boardId, data.targetId)))
          || (data.targetType == 'card'
            && get(board).data.get('archived', false) == false
            && exists(cardPath(workspaceId, data.boardId, data.targetId)))
        );
    }
    function validDeletionJobCreate(workspaceId, operationId) {
      let data = request.resource.data;
      let board = getAfter(boardPath(workspaceId, data.boardId)).data;
      let control = getAfter(boardLifecyclePath(workspaceId, data.boardId)).data;
      return validDeletionJobShape(data, operationId)
        && validDeletionTarget(workspaceId, data)
        && board.get('lifecycleState', 'active') == 'deleting'
        && board.activeDeletionJobId == operationId
        && board.revision == data.expectedRevision + 1
        && board.clientMutationId == operationId
        && control.state == 'deleting'
        && control.operationId == operationId
        && control.targetType == data.targetType
        && control.targetId == data.targetId;
    }
    function validLifecycleShape(data, boardId, operationId) {
      return data.keys().hasAll(['schemaVersion', 'boardId', 'state', 'operationId', 'targetType', 'targetId', 'initiatorUid', 'startedAt', 'completedAt', 'revision'])
        && data.keys().hasOnly(['schemaVersion', 'boardId', 'state', 'operationId', 'targetType', 'targetId', 'initiatorUid', 'startedAt', 'completedAt', 'revision'])
        && data.schemaVersion == 1
        && data.boardId == boardId
        && data.state == 'deleting'
        && data.operationId == operationId
        && validOperationId(data.operationId)
        && data.targetType in ['board', 'list', 'card']
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetId.size() <= 500
        && data.initiatorUid == request.auth.uid
        && data.startedAt == request.time
        && data.completedAt == null;
    }
    function validLifecycleStart(workspaceId, boardId, creating) {
      let data = request.resource.data;
      let job = getAfter(deletionJobPath(workspaceId, data.operationId)).data;
      let board = getAfter(boardPath(workspaceId, boardId)).data;
      return validLifecycleShape(data, boardId, data.operationId)
        && data.revision == (creating ? 0 : resource.data.revision + 1)
        && (creating || resource.data.state == 'active')
        && job.operationId == data.operationId
        && job.boardId == boardId
        && job.targetType == data.targetType
        && job.targetId == data.targetId
        && job.state == 'deleting'
        && deletionRoleAllowed(workspaceId, data.targetType)
        && board.get('lifecycleState', 'active') == 'deleting'
        && board.activeDeletionJobId == data.operationId;
    }
    function validBoardDeletionLock(workspaceId, boardId) {
      let operationId = request.resource.data.activeDeletionJobId;
      let job = getAfter(deletionJobPath(workspaceId, operationId)).data;
      let control = getAfter(boardLifecyclePath(workspaceId, boardId)).data;
      return resource.data.get('lifecycleState', 'active') == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifecycleState', 'activeDeletionJobId', 'revision', 'clientMutationId', 'updatedAt'])
        && request.resource.data.lifecycleState == 'deleting'
        && validRevision()
        && request.resource.data.clientMutationId == operationId
        && job.operationId == operationId
        && job.boardId == boardId
        && job.expectedRevision == resource.data.get('revision', 0)
        && job.state == 'deleting'
        && deletionRoleAllowed(workspaceId, job.targetType)
        && control.operationId == operationId
        && control.state == 'deleting';
    }
    function validListDeletionLock(workspaceId, boardId, listId) {
      let operationId = request.resource.data.activeDeletionJobId;
      let tombstone = getAfter(deletedListPath(workspaceId, boardId, listId)).data;
      return resource.data.get('lifecycleState', 'active') == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifecycleState', 'activeDeletionJobId', 'revision', 'clientMutationId', 'updatedAt'])
        && request.resource.data.lifecycleState == 'deleting'
        && validRevision()
        && request.resource.data.clientMutationId == operationId
        && tombstone.operationId == operationId
        && usableDeletionJobAfter(workspaceId, operationId, boardId, 'list', listId, '');
    }
    function validCardDeletionLock(workspaceId, boardId, cardId) {
      let operationId = request.resource.data.activeDeletionJobId;
      let tombstone = getAfter(deletedCardPath(workspaceId, boardId, cardId)).data;
      return resource.data.get('lifecycleState', 'active') == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifecycleState', 'activeDeletionJobId', 'revision', 'clientMutationId', 'updatedAt'])
        && request.resource.data.lifecycleState == 'deleting'
        && validRevision()
        && request.resource.data.clientMutationId == operationId
        && tombstone.operationId == operationId
