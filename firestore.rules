rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function workspaceDoc(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }
    function memberDoc(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }
    function currentMemberDoc(workspaceId) {
      return memberDoc(workspaceId, request.auth.uid);
    }
    function member(workspaceId) { return get(currentMemberDoc(workspaceId)).data; }
    function isMember(workspaceId) { return signedIn() && exists(currentMemberDoc(workspaceId)); }
    function isOwner(workspaceId) { return isMember(workspaceId) && member(workspaceId).role == 'owner'; }
    function isActiveWorkspace(workspaceId) {
      return get(workspaceDoc(workspaceId)).data.status == 'ready';
    }
    function canReadWorkspaceContent(workspaceId) {
      return isMember(workspaceId) && (
        isActiveWorkspace(workspaceId)
        || (isOwner(workspaceId) && get(workspaceDoc(workspaceId)).data.status == 'migrating')
      );
    }
    function canEdit(workspaceId) {
      return isMember(workspaceId)
        && member(workspaceId).role in ['owner', 'editor']
        && isActiveWorkspace(workspaceId);
    }
    function validRole(role) { return role in ['owner', 'editor', 'viewer']; }
    function validMemberProfile(data) {
      return (!data.keys().hasAny(['displayName']) || data.displayName is string && data.displayName.size() <= 120)
        && (!data.keys().hasAny(['photoURL']) || data.photoURL == '' || data.photoURL is string && data.photoURL.size() <= 2048 && data.photoURL.matches('https://lh3[.]googleusercontent[.]com/.*'))
        && (!data.keys().hasAny(['profileUpdatedAt']) || data.profileUpdatedAt == request.time);
    }
    function validOwnMemberProfileUpdate(workspaceId, uid) {
      return isActiveWorkspace(workspaceId)
        && uid == request.auth.uid
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.emailLower == resource.data.emailLower
        && request.resource.data.keys().hasAll(['displayName', 'photoURL', 'profileUpdatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'profileUpdatedAt'])
        && validMemberProfile(request.resource.data)
        && request.resource.data.profileUpdatedAt == request.time;
    }
    function invitePath(workspaceId, inviteId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(inviteId);
    }
    function inviteDoc(workspaceId, inviteId) { return get(invitePath(workspaceId, inviteId)).data; }
    function validInviteShape(data) {
      return data.keys().hasAll(['emailLower', 'role', 'createdBy', 'createdAt', 'expiresAt', 'revokedAt', 'acceptedAt', 'acceptedBy'])
        && data.keys().hasOnly(['emailLower', 'role', 'createdBy', 'createdAt', 'expiresAt', 'revokedAt', 'acceptedAt', 'acceptedBy'])
        && data.emailLower is string
        && data.emailLower.size() > 2
        && data.emailLower.size() <= 320
        && data.role in ['editor', 'viewer']
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(7, 'd')
        && data.revokedAt == null
        && data.acceptedAt == null
        && data.acceptedBy == null;
    }
    function activeInviteForCurrentUser(data) {
      return verifiedEmail()
        && request.auth.token.email == data.emailLower
        && data.acceptedAt == null
        && data.acceptedBy == null
        && data.revokedAt == null
        && data.expiresAt > request.time;
    }
    function validInviteMembershipCreate(workspaceId, uid) {
      let inviteId = request.resource.data.inviteId;
      let invite = inviteDoc(workspaceId, inviteId);
      let accepted = getAfter(invitePath(workspaceId, inviteId)).data;
      return request.resource.data.keys().hasAll(['uid', 'role', 'emailLower', 'inviteId'])
        && request.resource.data.uid == uid
        && uid == request.auth.uid
        && activeInviteForCurrentUser(invite)
        && request.resource.data.role == invite.role
        && request.resource.data.emailLower == invite.emailLower
        && accepted.acceptedAt == request.time
        && accepted.acceptedBy == request.auth.uid;
    }
    function validInviteAcceptance(workspaceId, inviteId) {
      let invite = resource.data;
      let joinedMember = getAfter(memberDoc(workspaceId, request.auth.uid)).data;
      let profileAfter = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return activeInviteForCurrentUser(invite)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedAt', 'acceptedBy'])
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.acceptedBy == request.auth.uid
        && joinedMember.uid == request.auth.uid
        && joinedMember.role == invite.role
        && joinedMember.emailLower == invite.emailLower
        && joinedMember.inviteId == inviteId
        && profileAfter.workspaceIds is list
        && profileAfter.workspaceIds.hasAll([workspaceId]);
    }
    function validOwnershipTransfer(workspaceId) {
      let previousOwner = resource.data.ownerUid;
      let nextOwner = request.resource.data.ownerUid;
      let oldOwnerAfter = getAfter(memberDoc(workspaceId, previousOwner)).data;
      let newOwnerBefore = get(memberDoc(workspaceId, nextOwner)).data;
      let newOwnerAfter = getAfter(memberDoc(workspaceId, nextOwner)).data;
      return isOwner(workspaceId)
        && previousOwner == request.auth.uid
        && nextOwner != previousOwner
        && newOwnerBefore.role in ['editor', 'viewer']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && oldOwnerAfter.uid == previousOwner
        && oldOwnerAfter.role in ['editor', 'viewer']
        && newOwnerAfter.uid == nextOwner
        && newOwnerAfter.role == 'owner';
    }
    function validMigrationCounts(counts) {
      return counts is map
        && counts.keys().hasAll(['boards', 'lists', 'cards'])
        && counts.keys().hasOnly(['boards', 'lists', 'cards'])
        && counts.boards is int && counts.boards >= 0 && counts.boards <= 100
        && counts.lists is int && counts.lists >= 0 && counts.lists <= 1000
        && counts.cards is int && counts.cards >= 0 && counts.cards <= 10000;
    }
    function validMigrationStart() {
      let migration = request.resource.data.migration;
      return resource.data.status == 'ready'
        && request.resource.data.status == 'migrating'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'migration', 'updatedAt'])
        && migration.keys().hasAll(['version', 'state', 'operationId', 'counts', 'startedAt'])
        && migration.keys().hasOnly(['version', 'state', 'operationId', 'counts', 'startedAt'])
        && migration.version == 2 && migration.state == 'migrating'
        && validOperationId(migration.operationId) && validMigrationCounts(migration.counts)
        && migration.startedAt == request.time;
    }
    function validMigrationProgress() {
      let before = resource.data.migration;
      let after = request.resource.data.migration;
      return resource.data.status == 'migrating'
        && request.resource.data.status == 'migrating'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migration', 'updatedAt'])
        && after.keys().hasAll(['version', 'state', 'operationId', 'counts', 'startedAt'])
        && after.keys().hasOnly(['version', 'state', 'operationId', 'counts', 'startedAt'])
        && before.version == 2 && after.version == 2 && after.state == 'migrating'
        && after.operationId == before.operationId && after.startedAt == before.startedAt
        && validMigrationCounts(after.counts);
    }
    function validMigrationFinish() {
      let before = resource.data.migration;
      let after = request.resource.data.migration;
      return resource.data.status == 'migrating'
        && request.resource.data.status == 'ready'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'migration', 'updatedAt'])
        && after.keys().hasAll(['version', 'state', 'operationId', 'counts', 'verifiedAt'])
        && after.keys().hasOnly(['version', 'state', 'operationId', 'counts', 'verifiedAt'])
        && before.version == 2 && after.version == 2 && after.state == 'verified'
        && after.operationId == before.operationId && validMigrationCounts(after.counts)
        && after.verifiedAt == request.time;
    }
    function validWorkspaceOwnerUpdate(workspaceId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let previousLifecycleRevision = resource.data.get('lifecycleRevision', 0);
      return isOwner(workspaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.updatedAt == request.time
        && (
          (changed.hasOnly(['name', 'lifecycleRevision', 'updatedAt'])
            && request.resource.data.lifecycleRevision == previousLifecycleRevision + 1
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80)
          || (resource.data.status == 'ready'
            && request.resource.data.status == 'archived'
            && changed.hasOnly(['status', 'lifecycleRevision', 'archivedAt', 'archivedByUid', 'updatedAt'])
            && request.resource.data.lifecycleRevision == previousLifecycleRevision + 1
            && request.resource.data.archivedAt == request.time
            && request.resource.data.archivedByUid == request.auth.uid)
          || (resource.data.status == 'archived'
            && request.resource.data.status == 'ready'
            && changed.hasOnly(['status', 'lifecycleRevision', 'archivedAt', 'archivedByUid', 'updatedAt'])
            && request.resource.data.lifecycleRevision == previousLifecycleRevision + 1
            && request.resource.data.archivedAt == null
            && request.resource.data.archivedByUid == null)
          || (resource.data.status == 'initializing'
            && request.resource.data.status == 'ready'
            && changed.hasOnly(['status', 'updatedAt']))
          || (resource.data.status == 'ready' && request.resource.data.status == 'migrating' && validMigrationStart())
          || (resource.data.status == 'migrating' && request.resource.data.status == 'migrating' && validMigrationProgress())
          || (resource.data.status == 'migrating' && request.resource.data.status == 'ready' && validMigrationFinish())
        );
    }
    function validTransferredMemberUpdate(workspaceId, uid) {
      let workspaceAfter = getAfter(workspaceDoc(workspaceId)).data;
      let previousOwner = get(workspaceDoc(workspaceId)).data.ownerUid;
      return isOwner(workspaceId)
        && previousOwner == request.auth.uid
        && workspaceAfter.ownerUid != previousOwner
        && (
          (uid == previousOwner
            && resource.data.role == 'owner'
            && request.resource.data.uid == uid
            && request.resource.data.role in ['editor', 'viewer'])
          || (uid == workspaceAfter.ownerUid
            && resource.data.role in ['editor', 'viewer']
            && request.resource.data.uid == uid
            && request.resource.data.role == 'owner')
        );
    }

    function validSelfLeave(workspaceId, uid) {
      let profileAfter = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return uid == request.auth.uid
        && resource.data.role != 'owner'
        && profileAfter.workspaceIds is list
        && !profileAfter.workspaceIds.hasAll([workspaceId]);
    }

    function validRevision() {
      let prior = resource.data.keys().hasAll(['revision']) ? resource.data.revision : -1;
      return request.resource.data.revision == prior + 1
        && request.resource.data.clientMutationId is string
        && request.resource.data.clientMutationId.size() >= 16
        && request.resource.data.clientMutationId.size() <= 128;
    }
    function validInitialRevision() {
      return request.resource.data.revision == 0
        && request.resource.data.clientMutationId is string
        && request.resource.data.clientMutationId.size() >= 16
        && request.resource.data.clientMutationId.size() <= 128;
    }
    function validAssigneeAt(workspaceId, assigneeUids, position) {
      return assigneeUids.size() <= position || (
        assigneeUids[position] is string
        && assigneeUids[position].size() >= 1
        && assigneeUids[position].size() <= 128
        && exists(memberDoc(workspaceId, assigneeUids[position]))
      );
    }
    function validCardAssignments(workspaceId, data) {
      let assigneeUids = data.assigneeUids;
      return data.keys().hasAll(['assigneeUids'])
        && assigneeUids is list
        && assigneeUids.size() <= 8
        && assigneeUids.toSet().size() == assigneeUids.size()
        && validAssigneeAt(workspaceId, assigneeUids, 0)
        && validAssigneeAt(workspaceId, assigneeUids, 1)
        && validAssigneeAt(workspaceId, assigneeUids, 2)
        && validAssigneeAt(workspaceId, assigneeUids, 3)
        && validAssigneeAt(workspaceId, assigneeUids, 4)
        && validAssigneeAt(workspaceId, assigneeUids, 5)
        && validAssigneeAt(workspaceId, assigneeUids, 6)
        && validAssigneeAt(workspaceId, assigneeUids, 7);
    }
    function validCardAssignmentUpdate(workspaceId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigneeUids'])
        || validCardAssignments(workspaceId, request.resource.data);
    }

    function boardPath(workspaceId, boardId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/boards/$(boardId);
    }
    function listPath(workspaceId, boardId, listId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/boards/$(boardId)/lists/$(listId);
    }
    function cardPath(workspaceId, boardId, cardId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/boards/$(boardId)/cards/$(cardId);
    }
    function boardLifecyclePath(workspaceId, boardId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/boardLifecycle/$(boardId);
    }
    function deletedListPath(workspaceId, boardId, listId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/boardLifecycle/$(boardId)/deletedLists/$(listId);
    }
    function deletedCardPath(workspaceId, boardId, cardId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/boardLifecycle/$(boardId)/deletedCards/$(cardId);
    }
    function deletionJobPath(workspaceId, operationId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/deletionJobs/$(operationId);
    }
    function validOperationId(value) {
      return value is string && value.size() >= 16 && value.size() <= 128;
    }
    function validIdempotentRevision(operationId) {
      return request.resource.data.revision == resource.data.revision
        && request.resource.data.clientMutationId == operationId;
    }
    function importPath(workspaceId, operationId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/imports/$(operationId);
    }
    function validImportCounts(counts) { return validMigrationCounts(counts) && counts.boards <= 4; }
    function validImportCreate(workspaceId, operationId) {
      let data = request.resource.data;
      let workspace = get(workspaceDoc(workspaceId)).data;
      return isOwner(workspaceId) && isActiveWorkspace(workspaceId) && workspace.personal == true
        && validOperationId(operationId) && data.operationId == operationId
        && data.keys().hasAll(['schemaVersion', 'operationId', 'sourceDigest', 'sourceCounts', 'targetBoardIds', 'createdByUid', 'state', 'createdAt', 'updatedAt', 'revision'])
        && data.keys().hasOnly(['schemaVersion', 'operationId', 'sourceDigest', 'sourceCounts', 'targetBoardIds', 'createdByUid', 'state', 'createdAt', 'updatedAt', 'revision'])
        && data.schemaVersion == 1 && data.sourceDigest is string && data.sourceDigest.matches('[0-9a-f]{64}')
        && validImportCounts(data.sourceCounts) && data.targetBoardIds is list
        && data.targetBoardIds.size() == data.sourceCounts.boards && data.targetBoardIds.size() <= 4
        && data.targetBoardIds.toSet().size() == data.targetBoardIds.size()
        && data.createdByUid == request.auth.uid && data.state == 'importing'
        && data.createdAt == request.time && data.updatedAt == request.time && data.revision == 0;
    }
    function validImportComplete(workspaceId, operationId) {
      return isOwner(workspaceId) && resource.data.operationId == operationId
        && resource.data.createdByUid == request.auth.uid && resource.data.state == 'importing'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt', 'revision'])
        && request.resource.data.state == 'verified' && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1;
    }
    function importCovers(workspaceId, operationId, boardId, after) {
      let path = importPath(workspaceId, operationId);
      let data = after ? getAfter(path).data : get(path).data;
      return validOperationId(operationId) && (after ? existsAfter(path) : exists(path))
        && data.operationId == operationId && data.createdByUid == request.auth.uid
        && data.targetBoardIds.hasAll([boardId]);
    }
    function importingBoardAfter(workspaceId, boardId, operationId) {
      let board = getAfter(boardPath(workspaceId, boardId)).data;
      return existsAfter(boardPath(workspaceId, boardId)) && board.lifecycleState == 'importing'
        && board.importOperationId == operationId;
    }
    function validImportedBoardCreate(workspaceId, boardId) {
      let operationId = request.resource.data.importOperationId;
      return isOwner(workspaceId) && isActiveWorkspace(workspaceId)
        && importCovers(workspaceId, operationId, boardId, false)
        && get(importPath(workspaceId, operationId)).data.state == 'importing'
        && request.resource.data.lifecycleState == 'importing'
        && validInitialRevision() && !request.resource.data.keys().hasAny(['snapshot', 'activeDeletionJobId'])
        && !existsAfter(boardLifecyclePath(workspaceId, boardId));
    }
    function validImportedBoardUpdate(workspaceId, boardId) {
      let operationId = request.resource.data.importOperationId;
      return isOwner(workspaceId) && resource.data.importOperationId == operationId
        && resource.data.lifecycleState == 'importing' && request.resource.data.lifecycleState == 'importing'
        && importCovers(workspaceId, operationId, boardId, false)
        && get(importPath(workspaceId, operationId)).data.state == 'importing'
        && (validRevision() || validIdempotentRevision(operationId))
        && !request.resource.data.keys().hasAny(['snapshot', 'activeDeletionJobId']);
    }
    function validImportedBoardFinalize(workspaceId, boardId) {
      let operationId = resource.data.importOperationId;
      return isOwner(workspaceId) && request.resource.data.importOperationId == operationId
        && resource.data.lifecycleState == 'importing' && request.resource.data.lifecycleState == 'active'
        && importCovers(workspaceId, operationId, boardId, true)
        && getAfter(importPath(workspaceId, operationId)).data.state == 'verified'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifecycleState', 'revision', 'clientMutationId', 'updatedAt'])
        && validRevision();
    }
    function validImportedListWrite(workspaceId, boardId, listId, create) {
      let operationId = request.resource.data.importOperationId;
      return isOwner(workspaceId) && importingBoardAfter(workspaceId, boardId, operationId)
        && importCovers(workspaceId, operationId, boardId, false)
        && get(importPath(workspaceId, operationId)).data.state == 'importing'
        && request.resource.data.lifecycleState == 'active' && listIsLiveAfter(workspaceId, boardId, listId)
        && (create ? validInitialRevision() : resource.data.importOperationId == operationId
          && (validRevision() || validIdempotentRevision(operationId)));
    }
    function validImportedCardWrite(workspaceId, boardId, cardId, create) {
      let operationId = request.resource.data.importOperationId;
      let list = getAfter(listPath(workspaceId, boardId, request.resource.data.listId)).data;
      return isOwner(workspaceId) && importingBoardAfter(workspaceId, boardId, operationId)
        && importCovers(workspaceId, operationId, boardId, false)
        && get(importPath(workspaceId, operationId)).data.state == 'importing'
        && list.importOperationId == operationId && list.lifecycleState == 'active'
        && request.resource.data.lifecycleState == 'active'
        && cardIsLiveAfter(workspaceId, boardId, cardId, request.resource.data.listId)
        && validCardAssignments(workspaceId, request.resource.data)
        && (create ? validInitialRevision() : resource.data.importOperationId == operationId
          && (validRevision() || validIdempotentRevision(operationId)));
    }
    function importReadable(workspaceId, boardId) {
      let board = get(boardPath(workspaceId, boardId)).data;
      let operationId = board.importOperationId;
      return isOwner(workspaceId) && board.lifecycleState == 'importing'
        && importCovers(workspaceId, operationId, boardId, false)
        && get(importPath(workspaceId, operationId)).data.state == 'importing';
    }
    function migrationActive(workspaceId, operationId) {
      let workspace = get(workspaceDoc(workspaceId)).data;
      return isOwner(workspaceId) && workspace.status == 'migrating'
        && workspace.migration.version == 2 && workspace.migration.state == 'migrating'
        && workspace.migration.operationId == operationId;
    }
    function validMigrationListWrite(workspaceId, boardId, listId, create) {
      let operationId = request.resource.data.migrationOperationId;
      let board = get(boardPath(workspaceId, boardId)).data;
      return migrationActive(workspaceId, operationId) && board.keys().hasAny(['snapshot'])
        && board.lifecycleState == 'active' && request.resource.data.lifecycleState == 'active'
        && listIsLiveAfter(workspaceId, boardId, listId)
        && (create ? validInitialRevision() : (!resource.data.keys().hasAny(['migrationOperationId'])
          || resource.data.migrationOperationId == operationId)
          && (validRevision() || validIdempotentRevision(operationId)));
    }
    function validMigrationIdentityAt(values, position) {
      return values.size() <= position || values[position] is string && values[position].size() >= 1 && values[position].size() <= 128;
    }
    function validMigrationAssignments(data) {
      let values = data.assigneeUids;
      return values is list && values.size() <= 8 && values.toSet().size() == values.size()
        && validMigrationIdentityAt(values, 0) && validMigrationIdentityAt(values, 1)
        && validMigrationIdentityAt(values, 2) && validMigrationIdentityAt(values, 3)
        && validMigrationIdentityAt(values, 4) && validMigrationIdentityAt(values, 5)
        && validMigrationIdentityAt(values, 6) && validMigrationIdentityAt(values, 7);
    }
    function validMigrationCardWrite(workspaceId, boardId, cardId, create) {
      let operationId = request.resource.data.migrationOperationId;
      let board = get(boardPath(workspaceId, boardId)).data;
      return migrationActive(workspaceId, operationId) && board.keys().hasAny(['snapshot'])
        && board.lifecycleState == 'active' && request.resource.data.lifecycleState == 'active'
        && getAfter(listPath(workspaceId, boardId, request.resource.data.listId)).data.lifecycleState == 'active'
        && cardIsLiveAfter(workspaceId, boardId, cardId, request.resource.data.listId)
        && validMigrationAssignments(request.resource.data)
        && (create ? validInitialRevision() : (!resource.data.keys().hasAny(['migrationOperationId'])
          || resource.data.migrationOperationId == operationId)
          && (validRevision() || validIdempotentRevision(operationId)));
    }
    function validSnapshotScrub(workspaceId, boardId) {
      let operationId = request.resource.data.lastMigrationOperationId;
      return migrationActive(workspaceId, operationId) && resource.data.keys().hasAny(['snapshot'])
        && !request.resource.data.keys().hasAny(['snapshot']) && request.resource.data.granularVersion == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['snapshot', 'granularVersion', 'lastMigrationOperationId', 'revision', 'clientMutationId', 'updatedAt'])
        && validRevision();
    }
    function deletionRoleAllowed(workspaceId, targetType) {
      return targetType == 'board' ? isOwner(workspaceId) : canEdit(workspaceId);
    }
    function jobCovers(data, boardId, entityType, entityId, listId) {
      return data.boardId == boardId && (
        data.targetType == 'board'
        || (entityType == 'list' && data.targetType == 'list' && data.targetId == entityId)
        || (entityType == 'card' && data.targetType == 'card' && data.targetId == entityId)
        || (entityType == 'card' && data.targetType == 'list' && data.targetId == listId)
      );
    }
    function usableDeletionJob(workspaceId, operationId, boardId, entityType, entityId, listId) {
      let path = deletionJobPath(workspaceId, operationId);
      let data = get(path).data;
      return validOperationId(operationId)
        && exists(path)
        && data.operationId == operationId
        && data.state in ['deleting', 'complete']
        && deletionRoleAllowed(workspaceId, data.targetType)
        && jobCovers(data, boardId, entityType, entityId, listId);
    }
    function usableDeletionJobAfter(workspaceId, operationId, boardId, entityType, entityId, listId) {
      let path = deletionJobPath(workspaceId, operationId);
      let data = getAfter(path).data;
      return validOperationId(operationId)
        && existsAfter(path)
        && data.operationId == operationId
        && data.state in ['deleting', 'complete']
        && deletionRoleAllowed(workspaceId, data.targetType)
        && jobCovers(data, boardId, entityType, entityId, listId);
    }
    function boardControlActiveAfter(workspaceId, boardId) {
      let path = boardLifecyclePath(workspaceId, boardId);
      return !existsAfter(path) || getAfter(path).data.state == 'active';
    }
    function boardWritable(workspaceId, boardId) {
      let path = boardPath(workspaceId, boardId);
      let board = getAfter(path).data;
      return canEdit(workspaceId)
        && existsAfter(path)
        && board.get('archived', false) == false
        && board.get('lifecycleState', 'active') == 'active'
        && boardControlActiveAfter(workspaceId, boardId);
    }
    function boardReadable(workspaceId, boardId) {
      let path = boardPath(workspaceId, boardId);
      let board = get(path).data;
      let control = boardLifecyclePath(workspaceId, boardId);
      return canReadWorkspaceContent(workspaceId)
        && exists(path)
        && board.get('archived', false) == false
        && board.get('lifecycleState', 'active') == 'active'
        && (!exists(control) || get(control).data.state == 'active');
    }
    function archivedBoardOwnerReadable(workspaceId, boardId) {
      let path = boardPath(workspaceId, boardId);
      let board = get(path).data;
      let control = boardLifecyclePath(workspaceId, boardId);
