        && data.keys().hasOnly(['schemaVersion', 'entityType', 'boardId', 'entityId', 'operationId', 'deletedByUid', 'createdAt'])
        && data.schemaVersion == 1
        && data.entityType == 'list'
        && data.boardId == boardId
        && data.entityId == listId
        && data.deletedByUid == request.auth.uid
        && data.createdAt == request.time
        && exists(listPath(workspaceId, boardId, listId))
        && getAfter(listPath(workspaceId, boardId, listId)).data.lifecycleState == 'deleting'
