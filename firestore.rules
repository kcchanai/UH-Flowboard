          : request.resource.data.archivedAt == null && request.resource.data.archivedByUid == null);
    }
    function boardPurgeReadable(workspaceId, boardId) {
      let path = boardLifecyclePath(workspaceId, boardId);
      return exists(path) ? (
        get(path).data.targetType == 'board'
          && usableDeletionJob(workspaceId, get(path).data.operationId, boardId, 'board', boardId, '')
      ) : false;
    }
    function entityPurgeBoardReadable(workspaceId, boardId) {
      let path = boardLifecyclePath(workspaceId, boardId);
      let data = get(path).data;
      return exists(path) && data.targetType in ['list', 'card']
        && usableDeletionJob(workspaceId, data.operationId, boardId, data.targetType, data.targetId, '');
    }
    function listPurgeReadable(workspaceId, boardId, listId) {
      let path = deletedListPath(workspaceId, boardId, listId);
      return boardPurgeReadable(workspaceId, boardId) ? true : (
        exists(path) ? usableDeletionJob(workspaceId, get(path).data.operationId, boardId, 'list', listId, '') : false
      );
    }
    function cardPurgeReadable(workspaceId, boardId, cardId, listId) {
      let cardTombstone = deletedCardPath(workspaceId, boardId, cardId);
      let listTombstone = deletedListPath(workspaceId, boardId, listId);
      return boardPurgeReadable(workspaceId, boardId) ? true : (
        exists(cardTombstone)
          ? usableDeletionJob(workspaceId, get(cardTombstone).data.operationId, boardId, 'card', cardId, get(cardTombstone).data.listId)
          : (exists(listTombstone) ? usableDeletionJob(workspaceId, get(listTombstone).data.operationId, boardId, 'card', cardId, listId) : false)
      );
    }
    function missingCardPurgeReadable(workspaceId, boardId, cardId) {
      let tombstone = deletedCardPath(workspaceId, boardId, cardId);
      return exists(tombstone)
        && usableDeletionJob(workspaceId, get(tombstone).data.operationId, boardId, 'card', cardId, get(tombstone).data.listId);
    }
    function commentPurgeReadable(workspaceId, boardId, cardId) {
      let card = cardPath(workspaceId, boardId, cardId);
      let tombstone = deletedCardPath(workspaceId, boardId, cardId);
      return boardPurgeReadable(workspaceId, boardId) ? true : (
        exists(tombstone)
          ? usableDeletionJob(workspaceId, get(tombstone).data.operationId, boardId, 'card', cardId, get(tombstone).data.listId)
          : (exists(card) ? listPurgeReadable(workspaceId, boardId, get(card).data.listId) : false)
      );
    }
    function listIsLiveAfter(workspaceId, boardId, listId) {
      return !existsAfter(deletedListPath(workspaceId, boardId, listId));
    }
    function cardIsLiveAfter(workspaceId, boardId, cardId, listId) {
      return !existsAfter(deletedCardPath(workspaceId, boardId, cardId))
        && !existsAfter(deletedListPath(workspaceId, boardId, listId));
    }
    function activeList(workspaceId, boardId, listId) {
      let path = listPath(workspaceId, boardId, listId);
      return exists(path) ? (
        get(path).data.get('lifecycleState', 'active') == 'active'
          && !exists(deletedListPath(workspaceId, boardId, listId))
      ) : false;
    }
    function commentParentsExist(workspaceId, boardId, cardId) {
      let card = cardPath(workspaceId, boardId, cardId);
      return boardReadable(workspaceId, boardId)
        && exists(card)
        && get(card).data.get('lifecycleState', 'active') == 'active'
        && !exists(deletedCardPath(workspaceId, boardId, cardId))
        && activeList(workspaceId, boardId, get(card).data.listId);
    }
    function archivedCommentParentsExist(workspaceId, boardId, cardId) {
      let card = cardPath(workspaceId, boardId, cardId);
      return archivedBoardOwnerReadable(workspaceId, boardId) && exists(card)
        && get(card).data.get('lifecycleState', 'active') == 'active'
        && !exists(deletedCardPath(workspaceId, boardId, cardId))
        && activeList(workspaceId, boardId, get(card).data.listId);
    }
    function commentParentsWritableAfter(workspaceId, boardId, cardId) {
      let card = cardPath(workspaceId, boardId, cardId);
      let listId = getAfter(card).data.listId;
      let list = listPath(workspaceId, boardId, listId);
      return boardWritable(workspaceId, boardId)
        && existsAfter(card)
        && getAfter(card).data.get('lifecycleState', 'active') == 'active'
        && !existsAfter(deletedCardPath(workspaceId, boardId, cardId))
        && existsAfter(list)
        && getAfter(list).data.get('lifecycleState', 'active') == 'active'
        && !existsAfter(deletedListPath(workspaceId, boardId, listId));
    }
    function activityPath(workspaceId, activityId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/activity/$(activityId);
    }
    function validCommentBody(body) { return body is string && body.size() > 0 && body.size() <= 2000; }
    function validCommentActivity(workspaceId, boardId, mutationId, action) {
      let event = getAfter(activityPath(workspaceId, mutationId)).data;
      return event.actorUid == request.auth.uid
        && event.action == action
        && event.boardId == boardId
        && event.clientMutationId == mutationId
        && event.createdAt == request.time;
    }
    function validCommentCreate(workspaceId, boardId, commentId) {
      let data = request.resource.data;
      return data.keys().hasAll(['authorUid', 'body', 'createdAt', 'updatedAt', 'deletedAt', 'revision', 'clientMutationId'])
        && data.keys().hasOnly(['authorUid', 'body', 'createdAt', 'updatedAt', 'deletedAt', 'revision', 'clientMutationId'])
        && data.authorUid == request.auth.uid
        && validCommentBody(data.body)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.deletedAt == null
        && data.revision == 0
        && data.clientMutationId == commentId
        && data.clientMutationId.size() >= 16
        && data.clientMutationId.size() <= 128
